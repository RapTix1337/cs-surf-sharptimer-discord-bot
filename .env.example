# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Token).
DISCORD_TOKEN=
# The server (guild) the bot operates in. Slash commands are registered here.
DISCORD_GUILD_ID=
# Channel where the bot maintains the auto-updating leaderboard message.
DISCORD_LEADERBOARD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Database (the SharpTimer database — the bot reads SharpTimer tables only)
# ---------------------------------------------------------------------------
# postgres | mysql  (mysql is experimental and not fully tested yet)
DB_DIALECT=postgres
DB_HOST=localhost
# Defaults to 5432 for postgres, 3306 for mysql.
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Table prefix SharpTimer was configured with. Usually empty.
DB_TABLE_PREFIX=

# ---------------------------------------------------------------------------
# Which records count towards the ranking
# ---------------------------------------------------------------------------
# SharpTimer style ID. 0 = normal; records with other styles are ignored.
RECORDS_STYLE=0
# SharpTimer mode filter. SharpTimer's default mode stores "Standard" in
# PlayerRecords. Check yours with: SELECT DISTINCT "Mode" FROM "PlayerRecords"
RECORDS_MODE=Standard

# ---------------------------------------------------------------------------
# Scoring (see README for the formula; the defaults are the documented ones)
# ---------------------------------------------------------------------------
# Flat completion bonus per finished map.
SCORING_BASE_POINTS=20
# Competition pot: pot = POT_PER_FINISHER * (finishers - 1), rank 1 wins it all.
SCORING_POT_PER_FINISHER=15
# Weights for rank score vs. time score.
SCORING_RANK_WEIGHT=0.5
SCORING_TIME_WEIGHT=0.5
# The slowest time is capped at CAP * fastest time to blunt outliers. Min 1.
SCORING_OUTLIER_CAP=3.0
# Bonus tracks award this fraction of the points of a main map.
SCORING_BONUS_WEIGHT=0.25

# ---------------------------------------------------------------------------
# Sync scheduler (leaderboard updates + role sync)
# ---------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Rank roles
# ---------------------------------------------------------------------------
# Master switch for role syncing.
ROLES_ENABLED=true
# every-rank : one role per rank (avoid with many players — role/rate limits)
# top3       : roles for ranks 1-3 only
# top10      : roles for ranks 1-10 only
# bundled    : #1, #2, #3, Top Ten, Top 100, Top 500, Top 1000
ROLES_MODE=top10
# Role name template; {rank} is replaced with the rank number.
# Bundled group roles use fixed names (Top Ten, Top 100, ...).
ROLES_NAME_TEMPLATE=Surf #{rank}
# Whether the bot sets role colors, and which ones (comma-separated hex list,
# applied to rank 1, 2, 3, ... in order; extra ranks get no color).
ROLES_SET_COLORS=true
ROLES_COLORS=#ffd700,#c0c0c0,#cd7f32
# Show role members separately in the member list.
ROLES_HOIST=false
